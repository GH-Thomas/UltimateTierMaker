<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:UltimateTierMaker.Views.ComponentViews"
             xmlns:models="clr-namespace:UltimateTierMaker.Models"
             x:DataType="models:Tier"
             x:Class="UltimateTierMaker.Views.ComponentViews.TierView">
    <HorizontalStackLayout>
        <Label 
            x:Name="tierLabel"
            Text="{Binding Name}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <CollectionView
            x:Name="collectionItems"
            ItemsSource="{Binding Items}"
            ItemsLayout="HorizontalList"
            BackgroundColor="Black"
            Margin="10,0,0,0"
            VerticalOptions="Center"
            HorizontalScrollBarVisibility="Always"> 
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <components:ItemView Item="{Binding}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </HorizontalStackLayout>
</ContentView>
