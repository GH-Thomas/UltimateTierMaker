<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:UltimateTierMaker.Views.ComponentViews"
             xmlns:models="clr-namespace:UltimateTierMaker.Models"
             x:Class="UltimateTierMaker.Views.ListPage"
             x:DataType="models:TierList"
             Title="ListPage">
    <VerticalStackLayout Padding="12">
        <Label
            Text="{Binding Name}"
            FontSize="24"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            Margin="0,0,0,12" />

        <components:TierListView TierList="{Binding .}" />
    </VerticalStackLayout>
</ContentPage>